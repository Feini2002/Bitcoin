{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yuqing Codex Bridge Daily Event Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "status",
    "generatedAt",
    "reportDate",
    "slot",
    "report",
    "grounding",
    "sourceRefs",
    "marketSnapshot",
    "costEstimate",
    "sourceErrors"
  ],
  "properties": {
    "kind": { "type": "string", "enum": ["daily_event"] },
    "status": { "type": "string", "enum": ["ready", "error"] },
    "generatedAt": { "type": "string" },
    "reportDate": { "type": "string" },
    "slot": { "type": "string" },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "marketTemperature",
        "macroTrend",
        "topStory",
        "topStories",
        "dynamicBriefs",
        "aiIntel",
        "githubTools",
        "trendRead",
        "sources",
        "quality"
      ],
      "properties": {
        "title": { "type": ["string", "null"] },
        "marketTemperature": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "macroTrend": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "topStory": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "topStories": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "dynamicBriefs": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "aiIntel": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "githubTools": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "trendRead": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "sources": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "quality": { "type": ["object", "array", "string", "number", "boolean", "null"] }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "taskId", "promptVersion"],
      "properties": {
        "generator": { "type": "string", "enum": ["codex_cli_bridge"] },
        "taskId": { "type": "string" },
        "promptVersion": { "type": "string" }
      }
    },
    "sourceRefs": { "type": "array" },
    "marketSnapshot": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "costEstimate": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "sourceErrors": { "type": "array" }
  }
}
