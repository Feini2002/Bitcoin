{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yuqing Codex Bridge Sentiment Analysis Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "status",
    "generatedAt",
    "reportDate",
    "slot",
    "report",
    "grounding",
    "sourceRefs",
    "marketSnapshot",
    "costEstimate",
    "sourceErrors"
  ],
  "properties": {
    "kind": { "type": "string", "enum": ["sentiment_analysis"] },
    "status": { "type": "string", "enum": ["ready", "error"] },
    "generatedAt": { "type": "string" },
    "reportDate": { "type": "string" },
    "slot": { "type": "string" },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "upstreamDaily",
        "marketState",
        "riskRadar",
        "opportunityScanner",
        "eventCalendar",
        "aiIntel",
        "trendRead",
        "incrementalSearch",
        "settingsSnapshot",
        "quality"
      ],
      "properties": {
        "title": { "type": ["string", "null"] },
        "upstreamDaily": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "marketState": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "riskRadar": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "opportunityScanner": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "eventCalendar": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "aiIntel": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "trendRead": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "incrementalSearch": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "settingsSnapshot": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "quality": { "type": ["object", "array", "string", "number", "boolean", "null"] }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "taskId", "promptVersion"],
      "properties": {
        "generator": { "type": "string", "enum": ["codex_cli_bridge"] },
        "taskId": { "type": "string" },
        "promptVersion": { "type": "string" }
      }
    },
    "sourceRefs": { "type": "array" },
    "marketSnapshot": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "costEstimate": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "sourceErrors": { "type": "array" }
  }
}
