# Copy this file to .env only when .env does not already exist.
# Keep real values in the root .env only; never use VITE_ for secrets.
GEMINI_API_KEY=
# GOOGLE_API_KEY= alternative to GEMINI_API_KEY
# FINNHUB_API_KEY=
# CRON_SECRET=
# SNAPSHOT_WRITE_TOKEN=
# ACCESS_SERVICE_CLIENT_ID=
# ACCESS_SERVICE_CLIENT_SECRET=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optional Cloudflare token authentication. Otherwise use npm run cf -- login.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Public local API overrides, only used by the local Vite server.
# BIT_DATA_API_BASE=http://127.0.0.1:8787
# BIT_YUQING_API_BASE=http://127.0.0.1:8788

# Local Binance egress VPS SSH (never commit real values).
# VPS_BINANCE_EGRESS_HOST=
# VPS_BINANCE_EGRESS_USER=root
# VPS_BINANCE_EGRESS_PASSWORD=
# VPS_BINANCE_EGRESS_PORT=22
# VPS_BINANCE_EGRESS_IDENTITY_FILE=.codex/ssh/bitdesk_egress_ed25519
# VPS_BINANCE_EGRESS_PROVIDER=vultr
# VPS_BINANCE_EGRESS_REGION=Tokyo
# Shared Worker <-> VPS reverse-proxy secret (wrangler secret + VPS env; never commit).
# EGRESS_PROXY_SECRET=
