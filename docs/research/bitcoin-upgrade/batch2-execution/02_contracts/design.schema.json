{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bitcoin-upgrade:design-contracts:2026-09-17",
  "title": "Synthetic design contract examples, not production schema",
  "$defs": {
    "Decimal": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "Time": {
      "type": "string",
      "format": "date-time"
    },
    "Quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "usable",
            "qualified",
            "missing",
            "invalid",
            "stale",
            "restricted"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "Window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_at",
        "end_at"
      ],
      "properties": {
        "start_at": {
          "$ref": "#/$defs/Time"
        },
        "end_at": {
          "$ref": "#/$defs/Time"
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "dataset_id",
        "instrument_id",
        "received_at",
        "window",
        "value",
        "unit",
        "quality",
        "example_only"
      ],
      "properties": {
        "kind": {
          "const": "observation"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "received_at": {
          "$ref": "#/$defs/Time"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "example_only": {
          "const": true
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "method_id",
        "method_version",
        "input_ids",
        "window",
        "value",
        "unit",
        "quality",
        "example_only"
      ],
      "properties": {
        "kind": {
          "const": "metric"
        },
        "id": {
          "type": "string"
        },
        "method_id": {
          "type": "string",
          "pattern": "^M[0-9]{2}$"
        },
        "method_version": {
          "type": "string"
        },
        "input_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "example_only": {
          "const": true
        }
      }
    },
    "Capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "instrument_id",
        "market_cutoff_at",
        "knowledge_cutoff_at",
        "time_mode",
        "input_ids",
        "metric_ids",
        "coverage",
        "example_only"
      ],
      "properties": {
        "kind": {
          "const": "capture"
        },
        "id": {
          "type": "string"
        },
        "instrument_id": {
          "type": "string"
        },
        "market_cutoff_at": {
          "$ref": "#/$defs/Time"
        },
        "knowledge_cutoff_at": {
          "$ref": "#/$defs/Time"
        },
        "time_mode": {
          "enum": [
            "system_observed",
            "publicly_available_reconstruction",
            "retrospective_latest"
          ]
        },
        "input_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metric_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "coverage": {
          "enum": [
            "sufficient_for_selected_scope",
            "partial",
            "insufficient",
            "unknown"
          ]
        },
        "example_only": {
          "const": true
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "capture_id",
        "generation_mode",
        "outcome",
        "facts",
        "limitations",
        "example_only"
      ],
      "properties": {
        "kind": {
          "const": "report"
        },
        "id": {
          "type": "string"
        },
        "capture_id": {
          "type": "string"
        },
        "generation_mode": {
          "enum": [
            "template",
            "model"
          ]
        },
        "outcome": {
          "enum": [
            "changes_identified",
            "initial_baseline",
            "no_material_change",
            "qualified",
            "insufficient_coverage"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "metric_ids"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "metric_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example_only": {
          "const": true
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope_id",
        "task_ids",
        "enabled_methods",
        "model_enabled",
        "external_calls_approved",
        "production_write_approved"
      ],
      "properties": {
        "kind": {
          "const": "scope"
        },
        "scope_id": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^NEW-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "enabled_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "model_enabled": {
          "type": "boolean"
        },
        "external_calls_approved": {
          "type": "boolean"
        },
        "production_write_approved": {
          "type": "boolean"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/Metric"
    },
    {
      "$ref": "#/$defs/Capture"
    },
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "#/$defs/Scope"
    }
  ]
}